# Auto detect text files and normalize line endings to LF
* text=auto

# Source files - normalize to LF
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.mvn/** text eol=lf
mvnw text eol=lf
mvnw.cmd text eol=lf
*.cmd text eol=lf
*.bat text eol=lf
*.log text eol=lf

# Binary files
*.jar binary
*.class binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
